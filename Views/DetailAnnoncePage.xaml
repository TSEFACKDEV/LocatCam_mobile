<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             x:DataType="vm:DetailAnnonceViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.DetailAnnoncePage"
             Title="Détail de l'annonce"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:PrixFcfaConverter x:Key="PrixFcfaConverter" />
            <cv:StringToBoolConverter x:Key="StringToBoolLocal" />
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ================= PHOTO (plein écran) ================= -->
                <Grid HeightRequest="320">

                    <!-- Fond doux -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                           BorderColor="Transparent"
                           CornerRadius="0"
                           Padding="0"
                           HasShadow="False">
                        <Label Text="&#xf015;" FontFamily="FASolid" FontSize="64"
                               TextColor="{AppThemeBinding Light={StaticResource CarteGlow}, Dark=#2A3F5C}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>

                    <!-- Photo réelle -->
                    <Image Source="{Binding Annonce.PhotoPrincipaleUrl}"
                           Aspect="AspectFill"
                           IsVisible="{Binding Annonce.PhotoPrincipaleUrl, Converter={StaticResource StringToBoolLocal}}" />

                    <!-- Bouton retour -->
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1F}"
                           BorderColor="Transparent"
                           CornerRadius="22"
                           Padding="0"
                           WidthRequest="44" HeightRequest="44"
                           HasShadow="False"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="16,48,0,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRetourClicked" />
                        </Frame.GestureRecognizers>
                        <Label Text="&#xf060;" FontFamily="FASolid" FontSize="17"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>

                    <!-- Bouton favori -->
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1F}"
                           BorderColor="Transparent"
                           CornerRadius="22"
                           Padding="0"
                           WidthRequest="44" HeightRequest="44"
                           HasShadow="False"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Margin="0,48,16,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFavoriCommand}" />
                        </Frame.GestureRecognizers>
                        <!-- Cœur vide (pas encore favori) -->
                        <Label Text="&#xf004;" FontFamily="FARegular" FontSize="19"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               IsVisible="{Binding EstFavori, Converter={StaticResource InverseBoolConverter}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- Cœur plein (favori) -->
                        <Label Text="&#xf004;" FontFamily="FASolid" FontSize="19"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               IsVisible="{Binding EstFavori}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>

                    <!-- Badge Vérifié -->
                    <Frame BackgroundColor="{StaticResource BadgeGlass}"
                           BorderColor="Transparent"
                           CornerRadius="10"
                           Padding="8,4"
                           HasShadow="False"
                           HorizontalOptions="Start"
                           VerticalOptions="End"
                           Margin="16,0,0,16"
                           IsVisible="{Binding Annonce.EstVerifie}">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="&#xf058;" FontFamily="FASolid" FontSize="12" TextColor="White" VerticalOptions="Center" />
                            <Label Text="Vérifié" FontFamily="PlusJakartaSans" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </Grid>

                <!-- ================= CONTENU ================= -->
                <VerticalStackLayout Padding="20,20,20,24" Spacing="16">

                    <!-- Titre + localisation -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Annonce.Titre}"
                               Style="{StaticResource H1}"
                               LineBreakMode="WordWrap" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Annonce.Quartier}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Label Text="•" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Label Text="{Binding Annonce.Ville}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Prix -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding Annonce.Prix, Converter={StaticResource PrixFcfaConverter}}"
                               FontFamily="PlusJakartaSans" FontSize="27" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                        <Label Text="/ mois" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,5" />
                    </HorizontalStackLayout>

                    <BoxView Style="{StaticResource Separateur}" />

                    <!-- Caractéristiques -->
                    <Label Text="Caractéristiques" Style="{StaticResource Micro}" />
                    <Grid ColumnDefinitions="*,*,*">

                        <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                            <Frame Style="{StaticResource PastilleIcone}">
                                <Label Text="&#xf1ad;" Style="{StaticResource IconeFa}" />
                            </Frame>
                            <Label Text="Type" Style="{StaticResource Micro}" HorizontalOptions="Center" />
                            <Label Text="{Binding Annonce.Type}" Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                            <Frame Style="{StaticResource PastilleIcone}">
                                <Label Text="&#xf236;" Style="{StaticResource IconeFa}" />
                            </Frame>
                            <Label Text="Pi\u00e8ces" Style="{StaticResource Micro}" HorizontalOptions="Center" />
                            <Label Text="{Binding Annonce.NombrePieces}" Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                            <Frame Style="{StaticResource PastilleIcone}">
                                <Label Text="&#xf4b8;" Style="{StaticResource IconeFa}" />
                            </Frame>
                            <Label Text="Meubl\u00e9" Style="{StaticResource Micro}" HorizontalOptions="Center" />
                            <Label Text="Oui" Style="{StaticResource Caption}" HorizontalOptions="Center"
                                   IsVisible="{Binding Annonce.EstMeuble}" />
                            <Label Text="Non" Style="{StaticResource Caption}" HorizontalOptions="Center"
                                   IsVisible="{Binding Annonce.EstMeuble, Converter={StaticResource InverseBoolConverter}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource Separateur}" />

                    <!-- Description -->
                    <Label Text="Description" Style="{StaticResource Micro}" />
                    <Label Text="{Binding Annonce.Description}"
                           Style="{StaticResource Body}"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                           LineBreakMode="WordWrap" />

                    <!-- Bailleur -->
                    <Frame Style="{StaticResource Card}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                           Padding="14"
                           Margin="0,6,0,0"
                           IsVisible="{Binding Annonce.NomBailleur, Converter={StaticResource StringToBoolLocal}}">
                        <HorizontalStackLayout Spacing="12">
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                   BorderColor="Transparent"
                                   CornerRadius="22"
                                   WidthRequest="44" HeightRequest="44"
                                   Padding="0"
                                   HasShadow="False">
                                <Label Text="&#xf007;" FontFamily="FASolid" FontSize="17"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Propos\u00e9 par" Style="{StaticResource Micro}" />
                                <Label Text="{Binding Annonce.NomBailleur}" Style="{StaticResource BodyFort}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= BARRE D'ACTION (fixe en bas) ================= -->
        <Frame Grid.Row="1"
               BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceCardDark}}"
               BorderColor="Transparent"
               CornerRadius="0"
               Padding="16,12,16,16"
               HasShadow="False">
            <Frame.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="14" Opacity="0.06" />
            </Frame.Shadow>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Contacter le bailleur"
                        Clicked="OnContacterClicked"
                        Style="{StaticResource PrimaryButton}" />

                <Button Grid.Column="1"
                        Text="&#xf095;"
                        FontFamily="FASolid"
                        FontSize="17"
                        Clicked="OnAppelerClicked"
                        Style="{StaticResource SecondaryButton}"
                        WidthRequest="56"
                        Padding="0"
                        IsVisible="{Binding Annonce.TelephoneBailleur, Converter={StaticResource StringToBoolLocal}}" />
            </Grid>
        </Frame>

    </Grid>

</ContentPage>
