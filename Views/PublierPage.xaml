<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.PublierPage"
             Title="Publier une annonce"
             x:DataType="vm:PublierViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ChampLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Setter Property="Margin" Value="16, 8, 16, 2" />
            </Style>
            <Style x:Key="ChampEntryStyle" TargetType="Entry">
                <Setter Property="Margin" Value="16, 0, 16, 10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- En-tête : titre de l'étape et progression -->
        <StackLayout Grid.Row="0" Margin="16, 16, 16, 8" Spacing="4">
            <Label Text="{Binding EtapeCourante, StringFormat='Étape {0}'}"
                   FontSize="12" TextColor="{StaticResource Primary}" />
            <Label x:Name="TitreEtapeLabel"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        </StackLayout>

        <!-- Bandeau erreur / succès -->
        <Grid Grid.Row="1">
            <ScrollView>
                <StackLayout Spacing="0">

                    <!-- Erreur -->
                    <Label Text="{Binding MessageErreur}"
                           IsVisible="{Binding MessageErreur, Converter={StaticResource StringToBoolConverter}}"
                           Margin="16, 8, 16, 4"
                           Padding="12"
                           TextColor="{StaticResource Error}"
                           BackgroundColor="{StaticResource ErrorLight}"
                           FontSize="14" />

                    <!-- Succès -->
                    <Label Text="{Binding MessageSucces}"
                           IsVisible="{Binding MessageSucces, Converter={StaticResource StringToBoolConverter}}"
                           Margin="16, 8, 16, 4"
                           Padding="12"
                           TextColor="{StaticResource Success}"
                           BackgroundColor="{StaticResource SuccessLight}"
                           FontSize="14" />

                    <!-- ======================== ÉTAPE : INFOS ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapeInfos}" Spacing="0">
                        <Label Text="Informations de l'annonce" FontSize="16" FontAttributes="Bold"
                               Margin="16, 14, 16, 8"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label Text="Titre" Style="{StaticResource ChampLabelStyle}" />
                        <Entry Text="{Binding Titre}" Placeholder="Ex: T2 meublé à Bonanama"
                               Style="{StaticResource ChampEntryStyle}" />

                        <Label Text="Description" Style="{StaticResource ChampLabelStyle}" />
                        <Editor Text="{Binding Description}" Placeholder="Décrivez votre logement..."
                               HeightRequest="100"
                               Margin="16, 0, 16, 10"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="16, 0, 16, 10">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Prix (FCFA)" Style="{StaticResource ChampLabelStyle}" />
                                <Entry Text="{Binding PrixTexte}" Placeholder="150000"
                                       Keyboard="Numeric"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Type" Style="{StaticResource ChampLabelStyle}" />
                                <Picker ItemsSource="{Binding TypesBien}"
                                        SelectedItem="{Binding Type}"
                                        Title="Sélectionner"
                                        Margin="0, 0, 0, 10"
                                        HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </StackLayout>
                        </Grid>

                        <Label Text="Quartier" Style="{StaticResource ChampLabelStyle}" />
                        <Entry Text="{Binding Quartier}" Placeholder="Ex: Bonanama"
                               Style="{StaticResource ChampEntryStyle}" />

                        <Label Text="Ville" Style="{StaticResource ChampLabelStyle}" />
                        <Entry Text="{Binding Ville}" Placeholder="Ex: Douala"
                               Style="{StaticResource ChampEntryStyle}" />

                        <Label Text="Adresse" Style="{StaticResource ChampLabelStyle}" />
                        <Entry Text="{Binding Adresse}" Placeholder="Ex: Rue de Bonanama, immeuble XYZ"
                               Style="{StaticResource ChampEntryStyle}" />
                    </StackLayout>

                    <!-- ======================== ÉTAPE : LOCALISATION ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapeLocalisation}" Spacing="0">
                        <Label Text="Localisation" FontSize="16" FontAttributes="Bold"
                               Margin="16, 14, 16, 8"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Vous pouvez préciser la position sur la carte (phase E) ou saisir les coordonnées ci-dessous."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               Margin="16, 0, 16, 10" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="16, 0, 16, 10">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Latitude" Style="{StaticResource ChampLabelStyle}" />
                                <Entry Text="{Binding Latitude}" Keyboard="Numeric"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Longitude" Style="{StaticResource ChampLabelStyle}" />
                                <Entry Text="{Binding Longitude}" Keyboard="Numeric"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>

                    <!-- ======================== ÉTAPE : OPTIONS ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapeOptions}" Spacing="0">
                        <Label Text="Options du logement" FontSize="16" FontAttributes="Bold"
                               Margin="16, 14, 16, 8"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <StackLayout Margin="16, 8, 16, 8" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Switch Grid.Column="0" IsToggled="{Binding EstMeuble}"
                                        HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="Meublé" VerticalOptions="Center"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Switch Grid.Column="0" IsToggled="{Binding Disponible}"
                                        HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="Disponible à la location" VerticalOptions="Center"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                        </StackLayout>

                        <Label Text="Nombre de pièces" Style="{StaticResource ChampLabelStyle}" Margin="16, 8, 16, 2" />
                        <Entry Text="{Binding NombrePieces}" Keyboard="Numeric"
                               Style="{StaticResource ChampEntryStyle}" />
                    </StackLayout>

                    <!-- ======================== ÉTAPE : PHOTOS (DÉSACTIVÉES - B1) ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapePhotos}" Spacing="0">
                        <Label Text="Photos" FontSize="16" FontAttributes="Bold"
                               Margin="16, 14, 16, 8"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Border Margin="16, 8, 16, 14"
                                BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource PrimaryLight}"
                                StrokeThickness="1"
                                Padding="16">
                            <StackLayout Spacing="8">
                                <Label Text="📷"
                                       FontSize="40"
                                       HorizontalOptions="Center" />
                                <Label Text="Upload de photos"
                                       FontSize="16" FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Temporairement indisponible — correctif API en cours (anomalie B1)."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Vous pourrez ajouter des photos dès que l'API sera corrigée."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Border>
                    </StackLayout>

                    <!-- ======================== ÉTAPE : APERÇU ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapeApercu}" Spacing="0">
                        <Label Text="Aperçu avant publication" FontSize="16" FontAttributes="Bold"
                               Margin="16, 14, 16, 8"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <StackLayout Margin="16, 8, 16, 14" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Titre" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding Titre}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Prix" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding PrixTexte, StringFormat='{0} FCFA'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Type" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding Type}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Quartier, Ville" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding Quartier, StringFormat='{0}, {1}', ConverterParameter=...}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Adresse" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding Adresse}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Meublé" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding EstMeuble, StringFormat='{0:Oui;Non}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="Pièces" WidthRequest="110"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding NombrePieces}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                        </StackLayout>
                    </StackLayout>

                    <!-- ======================== ÉTAPE : TERMINÉ ======================== -->
                    <StackLayout IsVisible="{Binding EstEtapeTermine}" Spacing="0">
                        <Border Margin="16, 14, 16, 14"
                                BackgroundColor="{StaticResource SuccessLight}"
                                Stroke="{StaticResource Success}"
                                StrokeThickness="1"
                                Padding="16">
                            <StackLayout Spacing="8">
                                <Label Text="✅"
                                       FontSize="40"
                                       HorizontalOptions="Center" />
                                <Label Text="Annonce publiée !"
                                       FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Success}" />
                                <Label Text="{Binding MessageSucces}"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </StackLayout>
                        </Border>
                    </StackLayout>

                </StackLayout>
            </ScrollView>

            <!-- Barre de navigation inférieure -->
            <Border Grid.Row="1" VerticalOptions="End"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Padding="16, 10, 16, 20">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Précédent"
                            Command="{Binding PrecedentCommand}"
                            IsEnabled="{Binding EstEtapeInfos, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            HeightRequest="48"
                            SemanticProperties.Description="Étape précédente"
                            SemanticProperties.Hint="Revenir à l'étape précédente du formulaire de publication" />
                    <Button Grid.Column="1" Text="Suivant"
                            Command="{Binding SuivantCommand}"
                            IsVisible="{Binding EstEtapeTermine, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="48"
                            SemanticProperties.Description="Étape suivante"
                            SemanticProperties.Hint="Passer à l'étape suivante du formulaire de publication" />
                    <Button Grid.Column="2" Text="Publier"
                            Command="{Binding PublierCommand}"
                            IsVisible="{Binding EstEtapeApercu}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            HeightRequest="48"
                            SemanticProperties.Description="Publier l'annonce"
                            SemanticProperties.Hint="Publier l'annonce créée et la mettre en ligne" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
