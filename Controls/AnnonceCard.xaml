<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             x:Class="LocatCam_mobile.Controls.AnnonceCard">

    <ContentView.Resources>
        <ResourceDictionary>
            <cv:PrixFcfaConverter x:Key="PrixFcfaConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Carte d'annonce : style Airbnb (coins arrondis, ombre douce, photo en avant) -->
    <Frame Style="{StaticResource Card}"
           HeightRequest="306"
           SemanticProperties.Description="{Binding Titre}"
           SemanticProperties.Hint="Annonce immobilière. Appuyez pour voir les détails">
        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Frame.GestureRecognizers>
        <Frame.Shadow>
            <Shadow Brush="#000000" Offset="0,6" Radius="16" Opacity="0.10" />
        </Frame.Shadow>

        <Grid RowDefinitions="182,Auto,Auto,Auto">

            <!-- ================= PHOTO ================= -->
            <Grid Grid.Row="0" InputTransparent="True">

                <!-- Fond doux (visible si pas de photo) -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                       BorderColor="Transparent"
                       CornerRadius="18,18,0,0"
                       Padding="0"
                       HasShadow="False">
                    <Label Text="&#xf015;"
                           FontFamily="FASolid"
                           FontSize="46"
                           TextColor="{AppThemeBinding Light={StaticResource CarteGlow}, Dark=#2A3F5C}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <!-- Photo réelle (si fournie par l'API) -->
                <Border StrokeThickness="0"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 18,18,0,0">
                    <Image Source="{Binding PhotoPrincipaleUrl}"
                           Aspect="AspectFill"
                           IsVisible="{Binding PhotoPrincipaleUrl, Converter={StaticResource StringToBoolConverter}}" />
                </Border>

                <!-- Badge "Vérifié" (en haut à gauche) -->
                <Frame BackgroundColor="{StaticResource BadgeGlass}"
                       BorderColor="Transparent"
                       CornerRadius="10"
                       Padding="7,3"
                       Margin="10,10,0,0"
                       HasShadow="False"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       IsVisible="{Binding EstVerifie}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="&#xf058;" FontFamily="FASolid" FontSize="11" TextColor="White" VerticalOptions="Center" />
                        <Label Text="Vérifié" FontFamily="PlusJakartaSansBold" FontSize="10.5" FontAttributes="None" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- Type (en bas à droite de la photo) -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1F}"
                       BorderColor="Transparent"
                       CornerRadius="9"
                       Padding="8,3"
                       Margin="0,0,10,10"
                       HasShadow="False"
                       HorizontalOptions="End"
                       VerticalOptions="End">
                    <Label Text="{Binding Type}"
                           FontFamily="PlusJakartaSansBold"
                           FontSize="10.5"
                           FontAttributes="None"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
                </Frame>
            </Grid>

            <!-- ================= TITRE ================= -->
            <Label Grid.Row="1"
                   Text="{Binding Titre}"
                   Style="{StaticResource BodyFort}"
                   Margin="14,12,14,2"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

            <!-- ================= LOCALISATION ================= -->
            <HorizontalStackLayout Grid.Row="2" Margin="14,0,14,0" Spacing="6">
                <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       VerticalOptions="Center" />
                <Label Text="{Binding Quartier}"
                       Style="{StaticResource Caption}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Label Text="•" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Label Text="{Binding Ville}"
                       Style="{StaticResource Caption}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- ================= PRIX ================= -->
            <Grid Grid.Row="3" Margin="14,9,14,13" ColumnDefinitions="Auto,Auto,*">
                <Label Grid.Column="0"
                       Text="{Binding Prix, Converter={StaticResource PrixFcfaConverter}}"
                       Style="{StaticResource Prix}"
                       VerticalOptions="End" />
                <Label Grid.Column="1"
                       Text="/ mois"
                       Style="{StaticResource Caption}"
                       Margin="4,0,0,1"
                       VerticalOptions="End" />
                <Label Grid.Column="2"
                       Text="&#xf054;"
                       FontFamily="FASolid"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       HorizontalOptions="End"
                       VerticalOptions="Center" />
            </Grid>

        </Grid>
    </Frame>

</ContentView>
