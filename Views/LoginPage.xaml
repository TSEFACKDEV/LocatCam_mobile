<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.LoginPage"
             Title="Connexion">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="20">

            <!-- Marque -->
            <Label Text="LocatCam"
                   Style="{StaticResource Display}"
                   HorizontalOptions="Center" />
            <Label Text="Connexion à votre compte"
                   Style="{StaticResource H2}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />

            <!-- Message d'erreur -->
            <Label Text="{Binding Message}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="{StaticResource Error}"
                   IsVisible="{Binding Message, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Champ Email -->
            <Frame Style="{StaticResource InputBorder}"
                   Margin="0,0,0,8">
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Champ Mot de passe -->
            <Frame Style="{StaticResource InputBorder}"
                   Margin="0,0,0,16">
                <Entry x:Name="MotDePasseEntry"
                       Placeholder="Mot de passe"
                       IsPassword="True"
                       Text="{Binding MotDePasse}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Bouton Se connecter -->
            <Button Text="Se connecter"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButton}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Lien inscription -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4" HorizontalOptions="Center">
                <Label Text="Pas encore de compte ?"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
                <Button Grid.Column="1" Text="Créer un compte"
                        Command="{Binding GoToRegisterCommand}"
                        Style="{StaticResource TextButton}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
