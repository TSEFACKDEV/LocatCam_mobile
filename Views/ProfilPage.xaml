<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:DataType="vm:ProfilViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.ProfilPage"
             Title="Mon profil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- En-tête profil -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Border Background="{AppThemeBinding Light={StaticResource SurfaceDark}, Dark={StaticResource Surface}}"
                        WidthRequest="100" HeightRequest="100"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 50">
                    <Label Text="👤"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding Nom}"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="{Binding Email}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="{Binding Role}"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

            <!-- Informations -->
            <Label Text="Informations du compte"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Nom"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding Nom}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                <Label Grid.Row="1" Grid.Column="0"
                       Text="Email"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding Email}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                <Label Grid.Row="2" Grid.Column="0"
                       Text="Téléphone"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Grid.Row="2" Grid.Column="1"
                       Text="{Binding Telephone}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,12,0,0" />

            <!-- Paramètres -->
            <Label Text="Paramètres"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Button Text="Mode sombre / clair"
                    HorizontalOptions="Fill" />

            <Button Text="Mes annonces"
                    HorizontalOptions="Fill" />

            <Button Text="Déconnexion"
                    Command="{Binding DeconnexionCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource Error}}"
                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorLight}}"
                    HorizontalOptions="Fill" />

            <BoxView HeightRequest="40" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
