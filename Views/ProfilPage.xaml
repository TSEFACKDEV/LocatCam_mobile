<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             x:DataType="vm:ProfilViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.ProfilPage"
             Title="Mon profil">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="MenuItem" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="16,6" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- Bandeau hors-ligne -->
            <ctrl:OfflineBanner />

            <!-- En-tête profil -->
            <StackLayout Padding="24, 20, 24, 16" Spacing="12" HorizontalOptions="Center">
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       CornerRadius="40"
                       Padding="0"
                       HasShadow="False"
                       WidthRequest="80" HeightRequest="80"
                       HorizontalOptions="Center">
                    <Label Text="U"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
                <Label Text="{Binding Nom}"
                       Style="{StaticResource H1}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding Email}"
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center" />
            </StackLayout>

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     Opacity="0.4" />

            <!-- Informations -->
            <StackLayout Padding="20, 16" Spacing="4">
                <Label Text="Informations du compte"
                       Style="{StaticResource Micro}" />

                <Frame Style="{StaticResource MenuItem}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="👤" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Nom complet"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Nom}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Grid Grid.Column="2" Grid.RowSpan="2" ColumnDefinitions="*" HorizontalOptions="End">
                            <Label Text="›" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                   VerticalOptions="Center" HorizontalOptions="End" />
                        </Grid>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource MenuItem}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="✉️" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Email"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Email}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource MenuItem}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="📱" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Téléphone"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Telephone}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </StackLayout>

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     Opacity="0.4" />

            <!-- Paramètres -->
            <StackLayout Padding="20, 16" Spacing="4">
                <Label Text="Paramètres"
                       Style="{StaticResource Micro}" />

                <Frame Style="{StaticResource MenuItem}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🌙" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Mode sombre"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="2" HorizontalOptions="End"
                                OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource MenuItem}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="📄 Mes annonces"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Text="›" FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>
                </Frame>
            </StackLayout>

            <BoxView HeightRequest="20" />

            <!-- Déconnexion -->
            <Button Text="Déconnexion"
                    Command="{Binding DeconnexionCommand}"
                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                    FontSize="16" FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 30" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
