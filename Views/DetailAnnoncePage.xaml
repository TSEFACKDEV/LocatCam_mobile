<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             x:DataType="vm:DetailAnnonceViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.DetailAnnoncePage"
             Title="Détail de l'annonce">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:PrixFcfaConverter x:Key="PrixFcfaConverter" />
            <cv:DateTimeToRelativeConverter x:Key="DateTimeToRelativeConverter" />
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ================= EN-TÊTE PHOTO (plein écran, ratio 4:3) ================= -->
            <Frame HeightRequest="340"
                   Padding="0"
                   HasShadow="False"
                   VerticalOptions="Fill"
                   HorizontalOptions="Fill"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}">
                <Grid>
                    <!-- Photo placeholder -->
                    <Label Text="📷"
                           FontSize="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />

                    <!-- Bouton retour (en haut à gauche) -->
                    <Frame VerticalOptions="Start" HorizontalOptions="Start"
                           Margin="12"
                           BackgroundColor="White"
                           Opacity="0.85"
                           CornerRadius="22"
                           Padding="0"
                           HasShadow="False"
                           WidthRequest="44" HeightRequest="44">
                        <Label Text="←" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>

                    <!-- Cœur favori (en haut à droite) -->
                    <Frame VerticalOptions="Start" HorizontalOptions="End"
                           Margin="12"
                           BackgroundColor="{Binding EstFavori, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                           Opacity="0.9"
                           CornerRadius="22"
                           Padding="0"
                           HasShadow="False"
                           WidthRequest="44" HeightRequest="44">
                        <Label Text="❤️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- ================= CONTENU (marges 24px) ================= -->
            <StackLayout Padding="24,20,24,0" Spacing="16">

                <!-- Titre -->
                <Label Text="{Binding Annonce.Titre}"
                       Style="{StaticResource H1}"
                       LineBreakMode="WordWrap" />

                <!-- Ligne localisation + badge vérifié -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
                    <Label Grid.Column="0" Text="{Binding Annonce.Quartier}"
                           Style="{StaticResource Caption}" LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="•" Style="{StaticResource Caption}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding Annonce.Ville}"
                           Style="{StaticResource Caption}" LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                    <Frame Grid.Column="3"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                           CornerRadius="10"
                           Padding="5,2"
                           HasShadow="False"
                           IsVisible="{Binding Annonce.EstVerifie}"
                           VerticalOptions="Center"
                           HorizontalOptions="End">
                        <Label Text="Vérifié" FontSize="9" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    </Frame>
                </Grid>

                <!-- Prix -->
                <Label Text="{Binding Annonce.Prix, Converter={StaticResource PrixFcfaConverter}}"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />

                <!-- Boutons d'action -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Contacter le bailleur : pilule pleine Accent -->
                    <Frame Grid.Column="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False">
                        <Label Text="Contacter le bailleur"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <!-- Signaler : texte Error -->
                    <Frame Grid.Column="1"
                           BackgroundColor="Transparent"
                           BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False">
                        <Label Text="Signaler"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>

                <!-- Séparateur Hairline -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                         Margin="0,16,0,16" />

                <!-- Informations (Type • Pièces) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                    <StackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                        <Label Text="TYPE" Style="{StaticResource Micro}" />
                        <Label Text="{Binding Annonce.Type}" Style="{StaticResource Caption}" />
                    </StackLayout>
                    <StackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="PIÈCES" Style="{StaticResource Micro}" />
                        <Label Text="{Binding Annonce.NombrePieces}" Style="{StaticResource Caption}" />
                    </StackLayout>
                </Grid>

                <!-- Séparateur Hairline -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                         Margin="0,16,0,16" />

                <!-- Description -->
                <Label Text="Description"
                       Style="{StaticResource Caption}" />
                <Label Text="{Binding Annonce.Description}"
                       Style="{StaticResource Body}"
                       LineBreakMode="WordWrap" />

                <BoxView HeightRequest="30" />

            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
