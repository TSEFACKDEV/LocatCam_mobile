<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LocatCam_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LocatCam_mobile"
    xmlns:views="clr-namespace:LocatCam_mobile.Views"
    Title="LocatCam">

    <!-- Page de connexion (point d'entrée si non connecté) -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Page d'inscription -->
    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />

    <!-- Page d'accueil (accessible après connexion) -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <!-- Page de test API (à remplacer par HomePage en Phase D) -->
    <ShellContent
        Title="Test API"
        ContentTemplate="{DataTemplate local:TestApiPage}"
        Route="TestApiPage" />

</Shell>
