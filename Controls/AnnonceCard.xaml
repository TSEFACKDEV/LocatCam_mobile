<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             x:Class="LocatCam_mobile.Controls.AnnonceCard">

    <ContentView.Resources>
        <ResourceDictionary>
            <cv:PrixFcfaConverter x:Key="PrixFcfaConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Carte d'annonce : style Airbnb (pas d'ombre, coins arrondis, séparateur Hairline entre cartes) -->
    <Frame Style="{StaticResource Card}"
           Padding="0"
           HeightRequest="270"
           SemanticProperties.Description="{Binding Titre}"
           SemanticProperties.Hint="Annonce immobilière. Appuyez pour voir les détails">

        <Grid RowDefinitions="120,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

            <!-- Photo principale (placeholder) : ratio 4:3 -->
            <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                   CornerRadius="0"
                   Padding="0"
                   HasShadow="False"
                   VerticalOptions="Fill"
                   HorizontalOptions="Fill">
                <Label Text="📷"
                       SemanticProperties.Description="Photo de l'annonce (placeholder)"
                       SemanticProperties.Hint="Image représentant le logement à louer"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
            </Frame>

            <!-- Badge "Vérifié" (bas gauche de la photo) -->
            <Frame Grid.Row="0" Grid.ColumnSpan="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                   CornerRadius="0"
                   Padding="6,3"
                   HasShadow="False"
                   VerticalOptions="End"
                   HorizontalOptions="Start"
                   Margin="8,0,0,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <Label Text="✔" FontSize="10" TextColor="White" VerticalOptions="Center" />
                    <Label Text="Vérifié" FontSize="9" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Cœur favori (haut droit) -->
            <Frame Grid.Row="0" Grid.Column="1"
                   BackgroundColor="White"
                   Opacity="0.9"
                   CornerRadius="20"
                   Padding="0"
                   HasShadow="False"
                   VerticalOptions="Start"
                   HorizontalOptions="End"
                   Margin="0,8,8,0"
                   WidthRequest="36" HeightRequest="36">
                <Label Text="❤️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <!-- Titre : 1 ligne max, ellipsis -->
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding Titre}"
                   Style="{StaticResource Body}"
                   Margin="12,10,12,4"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

            <!-- Sous-titre : Quartier · Ville + pilule Type à droite -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,2,12,0" ColumnSpacing="4">
                <Label Grid.Column="0" Text="{Binding Quartier}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="•" Style="{StaticResource Caption}" />
                <Label Grid.Column="2" Text="{Binding Ville}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                <Frame Grid.Column="3"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                       CornerRadius="12"
                       Padding="6,2"
                       HasShadow="False"
                       VerticalOptions="Center"
                       HorizontalOptions="End">
                    <Label Text="{Binding Type}" Style="{StaticResource Micro}" />
                </Frame>
            </Grid>

            <!-- Prix : H2 gras, aligné à droite -->
            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding Prix, Converter={StaticResource PrixFcfaConverter}}"
                   Style="{StaticResource H2}"
                   Margin="12,4,12,10"
                   HorizontalOptions="End" />
        </Grid>
    </Frame>

</ContentView>
