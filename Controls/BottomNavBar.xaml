<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Controls.BottomNavBar"
             x:Name="Root">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Pastille derrière l'icône de l'onglet actif -->
            <Style x:Key="NavPill" TargetType="Frame">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="NavLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="PlusJakartaSansSemiBold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="NavIcone" TargetType="Label">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Barre de navigation blanche arrondie en haut, ombre douce -->
    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceCardDark}}"
           BorderColor="Transparent"
           HasShadow="False"
           HorizontalOptions="Fill"
           VerticalOptions="End"
           CornerRadius="20,20,0,0"
           Padding="8,6,8,10">
        <Frame.Shadow>
            <Shadow Brush="#000000" Offset="0,-2" Radius="16" Opacity="0.06" />
        </Frame.Shadow>

        <Grid x:Name="GrilleOnglets" ColumnDefinitions="*,*,*,*,*">

            <!-- ============ ACCUEIL ============ -->
            <Grid Grid.Column="0" AutomationId="HomePage" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="HomePage" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame Grid.Row="0" x:Name="PillAccueil" Style="{StaticResource NavPill}" InputTransparent="True">
                    <Label x:Name="IconeAccueil" Text="&#xf015;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label Grid.Row="1" x:Name="LabelAccueil" Text="Accueil" Style="{StaticResource NavLabel}" InputTransparent="True" />
            </Grid>

            <!-- ============ CARTE ============ -->
            <Grid Grid.Column="1" AutomationId="CartePage" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="CartePage" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame Grid.Row="0" x:Name="PillCarte" Style="{StaticResource NavPill}" InputTransparent="True">
                    <Label x:Name="IconeCarte" Text="&#xf279;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label Grid.Row="1" x:Name="LabelCarte" Text="Carte" Style="{StaticResource NavLabel}" InputTransparent="True" />
            </Grid>

            <!-- ============ FAVORIS ============ -->
            <Grid Grid.Column="2" AutomationId="FavorisPage" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="FavorisPage" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame Grid.Row="0" x:Name="PillFavoris" Style="{StaticResource NavPill}" InputTransparent="True">
                    <Label x:Name="IconeFavoris" Text="&#xf004;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label Grid.Row="1" x:Name="LabelFavoris" Text="Favoris" Style="{StaticResource NavLabel}" InputTransparent="True" />
            </Grid>

            <!-- ============ PUBLIER (bailleurs uniquement) ============ -->
            <Grid x:Name="OngletPublier" Grid.Column="3" AutomationId="PublierPage" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="PublierPage" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame Grid.Row="0" x:Name="PillPublier" Style="{StaticResource NavPill}" InputTransparent="True">
                    <Label x:Name="IconePublier" Text="&#xf067;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label Grid.Row="1" x:Name="LabelPublier" Text="Publier" Style="{StaticResource NavLabel}" InputTransparent="True" />
            </Grid>

            <!-- ============ PROFIL ============ -->
            <Grid x:Name="OngletProfil" Grid.Column="4" AutomationId="ProfilPage" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="ProfilPage" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame Grid.Row="0" x:Name="PillProfil" Style="{StaticResource NavPill}" InputTransparent="True">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="28" HeightRequest="28">
                        <Label x:Name="IconeProfil" Text="&#xf007;" Style="{StaticResource NavIcone}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- Photo de profil affichée à la place de l'icône si elle existe -->
                        <Image x:Name="PhotoProfilNav"
                               IsVisible="False"
                               Aspect="AspectFill"
                               WidthRequest="26" HeightRequest="26"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Clip>
                                <EllipseGeometry RadiusX="13" RadiusY="13" Center="13,13" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Frame>
                <Label Grid.Row="1" x:Name="LabelProfil" Text="Profil" Style="{StaticResource NavLabel}" InputTransparent="True" />
            </Grid>

        </Grid>
    </Frame>

</ContentView>
