<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Controls.OfflineBanner"
             x:Name="Root">

    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorLightDark}}"
           BorderColor="Transparent"
           CornerRadius="0"
           Padding="16,10"
           HasShadow="False"
           IsVisible="{Binding IsOffline, Source={x:Reference Root}}">
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="&#xf071;"
                   FontFamily="FASolid"
                   FontSize="14"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Label Text="Vous êtes hors-ligne. Certaines fonctionnalités sont indisponibles."
                   FontFamily="PlusJakartaSans"
                   FontSize="13"
                   TextColor="White"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Frame>

</ContentView>
