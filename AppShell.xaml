<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LocatCam_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LocatCam_mobile.Views"
    Title="LocatCam">

    <!-- Onglet 1 : Accueil (TabBar natif cachée, BottomNavBar custom dans la page) -->
    <ShellContent
        Title="Accueil"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage"
        Shell.TabBarIsVisible="False" />

    <!-- Onglet 2 : Carte -->
    <ShellContent
        Title="Carte"
        ContentTemplate="{DataTemplate views:CartePage}"
        Route="CartePage"
        Shell.TabBarIsVisible="False" />

    <!-- Onglet 3 : Favoris -->
    <ShellContent
        Title="Favoris"
        ContentTemplate="{DataTemplate views:FavorisPage}"
        Route="FavorisPage"
        Shell.TabBarIsVisible="False" />

    <!-- Onglet 4 : Messagerie -->
    <ShellContent
        Title="Messages"
        ContentTemplate="{DataTemplate views:MessageriePage}"
        Route="MessageriePage"
        Shell.TabBarIsVisible="False" />

    <!-- Publication d'annonce (accédé via navigation, pas d'onglet) -->
    <ShellContent
        Title="Publier"
        ContentTemplate="{DataTemplate views:PublierPage}"
        Route="PublierPage"
        Shell.TabBarIsVisible="False" />

    <!-- Onglet 5 : Profil -->
    <ShellContent
        Title="Profil"
        ContentTemplate="{DataTemplate views:ProfilPage}"
        Route="ProfilPage"
        Shell.TabBarIsVisible="False" />

    <!-- Pages de connexion (pas d'onglet, accessibles via navigation) -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.TabBarIsVisible="False" />

    <!-- Page d'inscription -->
    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage"
        Shell.TabBarIsVisible="False" />

    <!-- Détail annonce (accédé via navigation paramétrée) -->
    <ShellContent
        Title="Détail annonce"
        ContentTemplate="{DataTemplate views:DetailAnnoncePage}"
        Route="DetailAnnoncePage"
        Shell.TabBarIsVisible="False" />

    <!-- Onboarding (premier lancement) -->
    <ShellContent
        Title="Onboarding"
        ContentTemplate="{DataTemplate views:OnboardingPage}"
        Route="OnboardingPage"
        Shell.TabBarIsVisible="False" />

</Shell>
