<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Controls.EmptyStateView"
             x:Name="This">

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14" Padding="32">

        <!-- Pastille avec icône -->
        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
               BorderColor="Transparent"
               CornerRadius="46"
               WidthRequest="92"
               HeightRequest="92"
               Padding="0"
               HasShadow="False"
               HorizontalOptions="Center">
            <Label Text="{Binding Source={x:Reference This}, Path=Icone}"
                   FontFamily="FASolid"
                   FontSize="34"
                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>

        <Label Text="{Binding Source={x:Reference This}, Path=Titre}"
               Style="{StaticResource H2}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label Text="{Binding Source={x:Reference This}, Path=Message}"
               Style="{StaticResource Caption}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               MaximumWidthRequest="300" />

        <Button Text="{Binding Source={x:Reference This}, Path=BoutonTexte}"
                Command="{Binding Source={x:Reference This}, Path=BoutonCommande}"
                IsVisible="{Binding Source={x:Reference This}, Path=AfficherBouton}"
                Style="{StaticResource PrimaryButton}"
                HorizontalOptions="Center"
                MinimumWidthRequest="200"
                Margin="0,8,0,0" />

    </VerticalStackLayout>

</ContentView>
