<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.PublierPage"
             Shell.NavBarIsVisible="False"
             Title="Publier une annonce"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"
             x:DataType="vm:PublierViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ChampLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="PlusJakartaSans" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
                <Setter Property="Margin" Value="4, 8, 4, 6" />
            </Style>
            <Style x:Key="ChampEntryStyle" TargetType="Entry">
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontFamily" Value="PlusJakartaSans" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ============ EN-TÊTE : PROGRESSION ============ -->
        <Grid Grid.Row="0" Padding="20,14,20,10" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding EtapeTexte}"
                       Style="{StaticResource Micro}"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                <Label x:Name="TitreEtapeLabel" Style="{StaticResource H2}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============ FORMULAIRE ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,16" Spacing="0">

                <!-- Messages d'erreur / succès -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorLightDark}}"
                       BorderColor="Transparent"
                       CornerRadius="14"
                       Padding="14,12"
                       Margin="0,4,0,10"
                       HasShadow="False"
                       IsVisible="{Binding MessageErreur, Converter={StaticResource StringToBoolConverter}}">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xf071;" FontFamily="FASolid" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding MessageErreur}"
                               FontFamily="PlusJakartaSans" FontSize="13.5"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessLightDark}}"
                       BorderColor="Transparent"
                       CornerRadius="14"
                       Padding="14,12"
                       Margin="0,4,0,10"
                       HasShadow="False"
                       IsVisible="{Binding MessageSucces, Converter={StaticResource StringToBoolConverter}}">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xf058;" FontFamily="FASolid" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding MessageSucces}"
                               FontFamily="PlusJakartaSans" FontSize="13.5"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- ======================== ÉTAPE : INFOS ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapeInfos}" Spacing="0">

                    <Label Text="Titre" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Titre}" Placeholder="Ex : T2 meublé à Bonanama"
                               Style="{StaticResource ChampEntryStyle}" />
                    </Frame>

                    <Label Text="Description" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Editor Text="{Binding Description}" Placeholder="Décrivez votre logement..."
                                HeightRequest="110"
                                FontFamily="PlusJakartaSans" FontSize="15"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                    </Frame>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="Prix (FCFA)" Style="{StaticResource ChampLabelStyle}" />
                            <Frame Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding PrixTexte}" Placeholder="15 000"
                                       Keyboard="Numeric"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Type" Style="{StaticResource ChampLabelStyle}" />
                            <Frame Style="{StaticResource InputBorder}" Padding="10,0">
                                <Picker ItemsSource="{Binding TypesBien}"
                                        SelectedItem="{Binding Type}"
                                        Title="Choisir"
                                        FontFamily="PlusJakartaSans"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                                        BackgroundColor="Transparent"
                                        HeightRequest="50"
                                        VerticalOptions="Center" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Quartier" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Quartier}" Placeholder="Ex : Bonanama"
                               Style="{StaticResource ChampEntryStyle}" />
                    </Frame>

                    <Label Text="Ville" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Ville}" Placeholder="Ex : Douala"
                               Style="{StaticResource ChampEntryStyle}" />
                    </Frame>

                    <Label Text="Adresse" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Adresse}" Placeholder="Ex : Rue de Bonanama, immeuble ABC"
                               Style="{StaticResource ChampEntryStyle}" />
                    </Frame>

                </VerticalStackLayout>

                <!-- ======================== ÉTAPE : LOCALISATION ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapeLocalisation}" Spacing="0">

                    <Label Text="Positionnez votre logement sur la carte pour être trouvé facilement par les étudiants."
                           Style="{StaticResource Caption}"
                           Margin="4,4,4,10"
                           HorizontalTextAlignment="Start" />

                    <!-- Bouton de géolocalisation automatique -->
                    <Button Grid.Column="2"
                            Text="&#xf124;  Ma position actuelle"
                            FontFamily="FASolid"
                            FontSize="14"
                            Command="{Binding MaPositionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalOptions="Fill"
                            Margin="0,0,0,10"
                            SemanticProperties.Description="Utiliser ma position GPS actuelle" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="Latitude" Style="{StaticResource ChampLabelStyle}" />
                            <Frame Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding LatitudeTexte}" Keyboard="Numeric"
                                       Placeholder="3.8480"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Longitude" Style="{StaticResource ChampLabelStyle}" />
                            <Frame Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding LongitudeTexte}" Keyboard="Numeric"
                                       Placeholder="11.5021"
                                       Style="{StaticResource ChampEntryStyle}" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Carte mini de prévisualisation (optionnelle, affiche la position saisie) -->
                    <Frame Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0"
                           IsVisible="{Binding LatitudeTexte, Converter={StaticResource StringToBoolConverter}}">
                        <Label Text="La position sera enregistrée avec l'annonce."
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center" />
                    </Frame>

                </VerticalStackLayout>

                <!-- ======================== ÉTAPE : OPTIONS ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapeOptions}" Spacing="0">

                    <Frame Style="{StaticResource Card}" Padding="16,6" Margin="0,4,0,12">
                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,10">
                                <Switch Grid.Column="0" IsToggled="{Binding EstMeuble}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                        HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Meublé" Style="{StaticResource BodyFort}" />
                                    <Label Text="Le logement est équipé de meubles" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource Separateur}" Margin="54,0,0,0" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,10">
                                <Switch Grid.Column="0" IsToggled="{Binding Disponible}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                        HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Disponible à la location" Style="{StaticResource BodyFort}" />
                                    <Label Text="Visible immédiatement par les étudiants" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="Nombre de pièces" Style="{StaticResource ChampLabelStyle}" />
                    <Frame Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding NombrePiecesTexte}" Keyboard="Numeric"
                               Style="{StaticResource ChampEntryStyle}" />
                    </Frame>

                </VerticalStackLayout>

                <!-- ======================== ÉTAPE : PHOTOS ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapePhotos}" Spacing="0">

                    <Frame Style="{StaticResource Card}" Padding="20" Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="12">

                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                   BorderColor="Transparent"
                                   CornerRadius="36"
                                   WidthRequest="72" HeightRequest="72"
                                   Padding="0" HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="&#xf030;" FontFamily="FASolid" FontSize="28"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>

                            <Label Text="Photos du logement"
                                   Style="{StaticResource H2}"
                                   HorizontalOptions="Center" />

                            <Label Text="Sélectionnez jusqu'à 6 photos de votre location. Elles seront envoyées sur Cloudinary."
                                   Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center" />

                            <!-- Bouton d'ajout -->
                            <Button Text="&#xf030;  Ajouter des photos"
                                    FontFamily="FASolid"
                                    FontSize="15"
                                    Command="{Binding SelectionnerPhotosCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalOptions="Fill"
                                    Margin="0,4,0,0"
                                    SemanticProperties.Description="Sélectionner des images depuis la galerie" />

                            <!-- Liste des photos sélectionnées (bindable layout) -->
                            <HorizontalStackLayout
                                BindableLayout.ItemsSource="{Binding PhotosSelectionnees}"
                                IsVisible="{Binding ADesPhotos}"
                                Spacing="8"
                                Padding="0,4,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="ImageSource">
                                        <Frame Style="{StaticResource Card}" Padding="2">
                                            <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80" />
                                        </Frame>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label Text="{Binding NbPhotosTexte}"
                                   Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />

                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

                <!-- ======================== ÉTAPE : APERÇU ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapeApercu}" Spacing="0">

                    <Frame Style="{StaticResource Card}" Padding="16,10" Margin="0,4,0,10">
                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Titre" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Titre}" Style="{StaticResource Body}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Prix" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding PrixTexte, StringFormat='{0} FCFA'}"
                                       Style="{StaticResource BodyFort}" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Type" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Body}" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Quartier" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="{Binding Quartier}" Style="{StaticResource Body}" VerticalOptions="Center" />
                                    <Label Text="•" Style="{StaticResource Body}" VerticalOptions="Center" />
                                    <Label Text="{Binding Ville}" Style="{StaticResource Body}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Adresse" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Adresse}" Style="{StaticResource Body}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Meublé" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Oui" Style="{StaticResource Body}"
                                       IsVisible="{Binding EstMeuble}" />
                                <Label Grid.Column="1" Text="Non" Style="{StaticResource Body}"
                                       IsVisible="{Binding EstMeuble, Converter={StaticResource InverseBoolConverter}}" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                <Label Text="Pièces" WidthRequest="96" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding NombrePieces}" Style="{StaticResource Body}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

                <!-- ======================== ÉTAPE : TERMINÉ ======================== -->
                <VerticalStackLayout IsVisible="{Binding EstEtapeTermine}" Spacing="0">

                    <Frame Style="{StaticResource Card}" Padding="20" Margin="0,4,0,0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessLightDark}}">
                        <VerticalStackLayout Spacing="12">

                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                   BorderColor="Transparent"
                                   CornerRadius="36"
                                   WidthRequest="72" HeightRequest="72"
                                   Padding="0" HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="&#xf058;" FontFamily="FASolid" FontSize="30" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>

                            <Label Text="Annonce publiée !"
                                   Style="{StaticResource H2}"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />

                            <Label Text="{Binding MessageSucces}"
                                   Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center" />

                            <Button Text="Retour à l'accueil"
                                    Clicked="OnRetourAccueilClicked"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,6,0,0" />

                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ BARRE D'ACTIONS ============ -->
        <Frame Grid.Row="2"
               BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceCardDark}}"
               BorderColor="Transparent"
               CornerRadius="0"
               Padding="16,10,16,14"
               HasShadow="False"
               IsVisible="{Binding EstEtapeTermine, Converter={StaticResource InverseBoolConverter}}">
            <Frame.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="14" Opacity="0.06" />
            </Frame.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Précédent"
                        Command="{Binding PrecedentCommand}"
                        IsEnabled="{Binding EstEtapeInfos, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource TextButton}"
                        TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                        SemanticProperties.Description="Étape précédente" />

                <Button Grid.Column="2"
                        Text="Suivant"
                        Command="{Binding SuivantCommand}"
                        IsVisible="{Binding EstEtapeApercu, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="160"
                        SemanticProperties.Description="Étape suivante" />

                <Button Grid.Column="2"
                        Text="Publier"
                        Command="{Binding PublierCommand}"
                        IsVisible="{Binding EstEtapeApercu}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="160"
                        SemanticProperties.Description="Publier l'annonce" />
            </Grid>
        </Frame>

        <!-- ============ BARRE DE NAVIGATION ============ -->
        <ctrl:BottomNavBar Grid.Row="3" EstActif="PublierPage" />

    </Grid>

</ContentPage>
