<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.OnboardingPage"
             Title="Bienvenue">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

        <!-- ============ CARROUSEL DES 3 SLIDES ============ -->
        <CarouselView Grid.Row="0"
                      x:Name="OnboardingCarousel"
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="OnboardingIndicator"
                      ItemsSource="{Binding Slides}"
                      Loop="False"
                      VerticalOptions="Fill">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="*,Auto" Padding="32,0,32,12" RowSpacing="28">

                        <!-- Illustration : pastille bleue avec icône blanche -->
                        <Frame Grid.Row="0"
                               WidthRequest="210" HeightRequest="210"
                               CornerRadius="105"
                               BorderColor="Transparent"
                               HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Frame.Shadow>
                                <Shadow Brush="#1565C0" Offset="0,14" Radius="30" Opacity="0.30" />
                            </Frame.Shadow>
                            <Label Text="{Binding Icone}"
                                   FontFamily="FASolid"
                                   FontSize="78"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <!-- Texte -->
                        <VerticalStackLayout Grid.Row="1" Spacing="12">
                            <Label Text="{Binding Titre}"
                                   Style="{StaticResource H1}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SousTitre}"
                                   Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- ============ PASSER (haut droite) ============ -->
        <Button Grid.Row="0"
                Text="Passer"
                Clicked="OnPasserClicked"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,44,12,0"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                FontFamily="PlusJakartaSans"
                FontAttributes="Bold"
                FontSize="14" />

        <!-- ============ BAS : PAGINATION + ACTIONS ============ -->
        <VerticalStackLayout Grid.Row="1" Spacing="22" Padding="24,0,24,36">

            <IndicatorView x:Name="OnboardingIndicator"
                           HorizontalOptions="Center"
                           IndicatorSize="8"
                           IndicatorColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                           SelectedIndicatorColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Précédent"
                        Clicked="OnPrecedentClicked"
                        IsVisible="{Binding EstPremierSlide, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource TextButton}"
                        TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />

                <Button Grid.Column="2"
                        Text="Suivant"
                        Clicked="OnSuivantClicked"
                        IsVisible="{Binding EstDernierSlide, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="170" />

                <Button Grid.Column="2"
                        Text="Commencer"
                        Clicked="OnCommencerClicked"
                        IsVisible="{Binding EstDernierSlide}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="170" />
            </Grid>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
