<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LocatCam_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LocatCam_mobile"
    Title="LocatCam_mobile">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Test API"
        ContentTemplate="{DataTemplate local:TestApiPage}"
        Route="TestApiPage" />

</Shell>
