<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.RegisterPage"
             Title="Inscription">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="16">

            <!-- Marque -->
            <Label Text="Créer un compte"
                   Style="{StaticResource Display}"
                   HorizontalOptions="Center" />
            <Label Text="Rejoignez LocatCam"
                   Style="{StaticResource H2}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />

            <!-- Message -->
            <Label Text="{Binding Message}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="{StaticResource Error}"
                   IsVisible="{Binding Message, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Nom -->
            <Frame Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                <Entry x:Name="NomEntry"
                       Placeholder="Nom complet"
                       Text="{Binding Nom}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Email -->
            <Frame Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Téléphone -->
            <Frame Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                <Entry x:Name="TelephoneEntry"
                       Placeholder="+237 6XX XXX XXX"
                       Keyboard="Telephone"
                       Text="{Binding Telephone}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Mot de passe -->
            <Frame Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                <Entry x:Name="MotDePasseEntry"
                       Placeholder="Mot de passe (min 6 car.)"
                       IsPassword="True"
                       Text="{Binding MotDePasse}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Confirmation -->
            <Frame Style="{StaticResource InputBorder}" Margin="0,0,0,16">
                <Entry x:Name="ConfirmationEntry"
                       Placeholder="Confirmer le mot de passe"
                       IsPassword="True"
                       Text="{Binding ConfirmationMotDePasse}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       HorizontalOptions="Fill" />
            </Frame>

            <!-- Rôle -->
            <Label Text="Rôle"
                   Style="{StaticResource Caption}"
                   Margin="0,4,0,4" />
            <Picker x:Name="RolePicker"
                    Title="Sélectionner un rôle"
                    SelectedItem="{Binding Role}"
                    HorizontalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Etudiant</x:String>
                        <x:String>Bailleur</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!-- Bouton S'inscrire -->
            <Button Text="S'inscrire"
                    Command="{Binding RegisterCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Lien connexion -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4" HorizontalOptions="Center">
                <Label Text="Déjà un compte ?"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
                <Button Grid.Column="1" Text="Connectez-vous"
                        Command="{Binding GoToLoginCommand}"
                        Style="{StaticResource TextButton}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
