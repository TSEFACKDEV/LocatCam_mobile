<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.MessageriePage"
             Title="Messagerie">

    <Grid>
        <!-- ======================== LISTE DES CONVERSATIONS ======================== -->
        <StackLayout x:Name="ListeConversationsPanel"
                     IsVisible="{Binding ConversationOuverte, Converter={StaticResource InverseBoolConverter}}"
                     Spacing="0">

            <StackLayout Margin="16, 16, 16, 8" Spacing="4">
                <Label Text="Mes conversations"
                       Style="{StaticResource H1}" />
                <Label Text="{Binding TotalNonLus, StringFormat='{0} message(s) non lu(s)'}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
            </StackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoadingConversations}"
                               IsVisible="{Binding IsLoadingConversations}"
                               HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Conversations}"
                            SelectionMode="Single"
                            SelectedItem="{Binding ConversationSelectionnee, Mode=TwoWay}"
                            Margin="12, 0, 12, 0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource Card}"
                               Padding="12"
                               HasShadow="False">
                            <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Frame Grid.Column="0"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       CornerRadius="30"
                                       Padding="0"
                                       HasShadow="False"
                                       WidthRequest="40" HeightRequest="40"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start">
                                    <Label Text="U"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>

                                <!-- Infos -->
                                <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding UtilisateurNom}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DernierMessage, FallbackValue='Aucun message'}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                </StackLayout>

                                <!-- Heure + badge non-lus -->
                                <StackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Start" Spacing="4">
                                    <Label Text="{Binding DateDernierMessage, StringFormat='{0:dd/MM HH:mm}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                           CornerRadius="10"
                                           Padding="4"
                                           HasShadow="False"
                                           IsVisible="{Binding MessagesNonLus, Converter={StaticResource StringToBoolConverter}}">
                                        <Label Text="{Binding MessagesNonLus}"
                                               FontSize="10" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Aucune conversation pour le moment."
                   HorizontalOptions="Center"
                   VerticalOptions="CenterAndExpand"
                   TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
        </StackLayout>

        <!-- ======================== DÉTAIL CONVERSATION ======================== -->
        <StackLayout x:Name="DetailConversationPanel"
                     IsVisible="{Binding ConversationOuverte}"
                     Spacing="0">

            <Grid Margin="16, 10, 16, 8" ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="← Retour"
                        Command="{Binding FermerConversationCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        HeightRequest="40"
                        SemanticProperties.Description="Fermer la conversation"
                        SemanticProperties.Hint="Revenir à la liste des conversations" />
                <Label Grid.Column="1" Text="{Binding ConversationSelectionnee.UtilisateurNom}"
                       Style="{StaticResource H2}"
                       VerticalTextAlignment="Center" />
            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     Opacity="0.3" />

            <!-- Messages -->
            <ScrollView>
                <StackLayout BindableLayout.ItemsSource="{Binding Messages}"
                             Spacing="12" Padding="12, 10, 12, 0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto">
                                <!-- Bulle de chat (à gauche) -->
                                <Frame Grid.Row="0"
                                       Padding="12"
                                       CornerRadius="16"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                                       HasShadow="False"
                                       HorizontalOptions="Start"
                                       WidthRequest="260">
                                    <Label Text="{Binding Contenu}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                                           LineBreakMode="WordWrap" />
                                </Frame>
                                <Label Grid.Row="1"
                                       Text="{Binding DateEnvoi, StringFormat='{0:HH:mm}'}"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                                       HorizontalOptions="End"
                                       Margin="12, 0, 0, 0" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
            </ScrollView>

            <!-- Zone de saisie -->
            <Frame Margin="12, 8, 12, 16"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                   CornerRadius="24"
                   Padding="8"
                   HasShadow="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding ContenuNouveauMessage}"
                           Placeholder="Écrire un message..."
                           Keyboard="Text"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
                    <Button Grid.Column="1" Text="Envoyer"
                            Command="{Binding EnvoyerMessageCommand}"
                            IsEnabled="{Binding ContenuNouveauMessage, Converter={StaticResource StringToBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="40"
                            WidthRequest="80"
                            SemanticProperties.Description="Envoyer le message"
                            SemanticProperties.Hint="Envoyer le message saisi dans la conversation" />
                </Grid>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsLoadingMessages}"
                               IsVisible="{Binding IsLoadingMessages}"
                               HorizontalOptions="Center" />
        </StackLayout>
    </Grid>

</ContentPage>
