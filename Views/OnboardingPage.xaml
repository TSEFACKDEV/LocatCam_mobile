<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.OnboardingPage"
             Shell.NavBarIsVisible="False"
             Title="Bienvenue"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ HALOS DÉCORATIFS (fond doux) ============ -->
        <Grid Grid.RowSpan="3" InputTransparent="True">
            <Ellipse Fill="{AppThemeBinding Light=#E9EEFF, Dark=#1A2140}"
                     WidthRequest="320" HeightRequest="320"
                     Opacity="0.8"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-140,-120,0" />
            <Ellipse Fill="{AppThemeBinding Light=#F4EDFF, Dark=#221A38}"
                     WidthRequest="240" HeightRequest="240"
                     Opacity="0.55"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-100,0,0,-80" />
        </Grid>

        <!-- ============ PASSER (barre du haut) ============ -->
        <Button Grid.Row="0"
                Text="Passer"
                Clicked="OnPasserClicked"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Margin="0,6,14,0"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                FontFamily="PlusJakartaSansBold"
                FontAttributes="None"
                FontSize="14" />

        <!-- ============ CARROUSEL DES 3 ÉTAPES ============ -->
        <CarouselView Grid.Row="1"
                      x:Name="OnboardingCarousel"
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="OnboardingIndicator"
                      ItemsSource="{Binding Slides}"
                      Loop="False"
                      IsBounceEnabled="True"
                      VerticalOptions="Fill">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="*,Auto"
                          Padding="24,4,24,8"
                          RowSpacing="26">

                        <!-- Illustration unDraw dans une carte douce -->
                        <Border Grid.Row="0"
                                Padding="12"
                                MinimumHeightRequest="250"
                                VerticalOptions="Fill"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#1B1F2A}" Offset="0.0" />
                                    <GradientStop Color="{AppThemeBinding Light=#F3F6FF, Dark=#161A24}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#1B2559" Offset="0,16" Radius="36" Opacity="0.10" />
                            </Border.Shadow>

                            <Image Source="{Binding Illustration}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   Margin="6" />
                        </Border>

                        <!-- Texte de l'étape -->
                        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="4,0">
                            <Frame Style="{StaticResource Pill}"
                                   Padding="13,6"
                                   HorizontalOptions="Center">
                                <Label Text="{Binding Etiquette}"
                                       Style="{StaticResource Micro}"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                            </Frame>

                            <Label Text="{Binding Titre}"
                                   Style="{StaticResource Display}"
                                   FontSize="27"
                                   CharacterSpacing="0"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <Label Text="{Binding SousTitre}"
                                   Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- ============ BAS : PAGINATION + ACTIONS ============ -->
        <VerticalStackLayout Grid.Row="2" Spacing="20" Padding="24,0,24,34">

            <IndicatorView x:Name="OnboardingIndicator"
                           HorizontalOptions="Center"
                           IndicatorSize="8"
                           IndicatorColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                           SelectedIndicatorColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Précédent"
                        Clicked="OnPrecedentClicked"
                        IsVisible="{Binding EstPremierSlide, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource TextButton}"
                        TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />

                <Button Grid.Column="2"
                        Text="Suivant"
                        Clicked="OnSuivantClicked"
                        IsVisible="{Binding EstDernierSlide, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="164" />

                <Button Grid.Column="2"
                        Text="Commencer"
                        Clicked="OnCommencerClicked"
                        IsVisible="{Binding EstDernierSlide}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="184" />
            </Grid>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
