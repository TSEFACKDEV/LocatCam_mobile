<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Controls.BottomNavBar"
             x:Name="Root">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Pastille derrière l'icône de l'onglet actif -->
            <Style x:Key="NavPill" TargetType="Frame">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="NavLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="PlusJakartaSansSemiBold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="NavIcone" TargetType="Label">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Barre de navigation blanche arrondie en haut, ombre douce -->
    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceCardDark}}"
           BorderColor="Transparent"
           HasShadow="False"
           HorizontalOptions="Fill"
           VerticalOptions="End"
           CornerRadius="20,20,0,0"
           Padding="8,6,8,10">
        <Frame.Shadow>
            <Shadow Brush="#000000" Offset="0,-2" Radius="16" Opacity="0.06" />
        </Frame.Shadow>

        <Grid ColumnDefinitions="*,*,*,*,*">

            <!-- ============ ACCUEIL ============ -->
            <VerticalStackLayout Grid.Column="0" AutomationId="HomePage" Spacing="3" HorizontalOptions="Fill">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="HomePage" />
                </VerticalStackLayout.GestureRecognizers>
                <Frame x:Name="PillAccueil" Style="{StaticResource NavPill}">
                    <Label x:Name="IconeAccueil" Text="&#xf015;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label x:Name="LabelAccueil" Text="Accueil" Style="{StaticResource NavLabel}" />
            </VerticalStackLayout>

            <!-- ============ CARTE ============ -->
            <VerticalStackLayout Grid.Column="1" AutomationId="CartePage" Spacing="3" HorizontalOptions="Fill">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="CartePage" />
                </VerticalStackLayout.GestureRecognizers>
                <Frame x:Name="PillCarte" Style="{StaticResource NavPill}">
                    <Label x:Name="IconeCarte" Text="&#xf279;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label x:Name="LabelCarte" Text="Carte" Style="{StaticResource NavLabel}" />
            </VerticalStackLayout>

            <!-- ============ FAVORIS ============ -->
            <VerticalStackLayout Grid.Column="2" AutomationId="FavorisPage" Spacing="3" HorizontalOptions="Fill">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="FavorisPage" />
                </VerticalStackLayout.GestureRecognizers>
                <Frame x:Name="PillFavoris" Style="{StaticResource NavPill}">
                    <Label x:Name="IconeFavoris" Text="&#xf004;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label x:Name="LabelFavoris" Text="Favoris" Style="{StaticResource NavLabel}" />
            </VerticalStackLayout>

            <!-- ============ PUBLIER ============ -->
            <VerticalStackLayout Grid.Column="3" AutomationId="PublierPage" Spacing="3" HorizontalOptions="Fill">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="PublierPage" />
                </VerticalStackLayout.GestureRecognizers>
                <Frame x:Name="PillPublier" Style="{StaticResource NavPill}">
                    <Label x:Name="IconePublier" Text="&#xf067;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label x:Name="LabelPublier" Text="Publier" Style="{StaticResource NavLabel}" />
            </VerticalStackLayout>

            <!-- ============ PROFIL ============ -->
            <VerticalStackLayout Grid.Column="4" AutomationId="ProfilPage" Spacing="3" HorizontalOptions="Fill">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOngletTapped" CommandParameter="ProfilPage" />
                </VerticalStackLayout.GestureRecognizers>
                <Frame x:Name="PillProfil" Style="{StaticResource NavPill}">
                    <Label x:Name="IconeProfil" Text="&#xf007;" Style="{StaticResource NavIcone}" />
                </Frame>
                <Label x:Name="LabelProfil" Text="Profil" Style="{StaticResource NavLabel}" />
            </VerticalStackLayout>

        </Grid>
    </Frame>

</ContentView>
