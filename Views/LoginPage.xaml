<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.LoginPage"
             Title="Connexion"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,32" Spacing="22">

            <!-- ============ MARQUE ============ -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                   BorderColor="Transparent"
                   CornerRadius="20"
                   Padding="0"
                   WidthRequest="76"
                   HeightRequest="76"
                   HasShadow="False"
                   HorizontalOptions="Center">
                <Frame.Shadow>
                    <Shadow Brush="#1565C0" Offset="0,10" Radius="22" Opacity="0.30" />
                </Frame.Shadow>
                <Label Text="&#xf015;" FontFamily="FASolid" FontSize="32" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <VerticalStackLayout Spacing="6" Margin="0,6,0,10">
                <Label Text="LocatCam" Style="{StaticResource Display}" HorizontalOptions="Center" />
                <Label Text="Connectez-vous pour trouver votre logement"
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- ============ MESSAGE D'ERREUR ============ -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorLightDark}}"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="14,12"
                   HasShadow="False"
                   IsVisible="{Binding Message, Converter={StaticResource StringToBoolConverter}}">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="&#xf071;" FontFamily="FASolid" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Message}"
                           FontFamily="PlusJakartaSans"
                           FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- ============ CHAMP EMAIL ============ -->
            <Frame Style="{StaticResource InputBorder}" HeightRequest="56">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="&#xf0e0;" FontFamily="FASolid" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Adresse email"
                           Keyboard="Email"
                           Text="{Binding Email}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                           FontFamily="PlusJakartaSans"
                           FontSize="15"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- ============ CHAMP MOT DE PASSE ============ -->
            <Frame Style="{StaticResource InputBorder}" HeightRequest="56">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="&#xf023;" FontFamily="FASolid" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Mot de passe"
                           IsPassword="True"
                           Text="{Binding MotDePasse}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                           FontFamily="PlusJakartaSans"
                           FontSize="15"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- ============ BOUTON CONNEXION ============ -->
            <Button Text="Se connecter"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                               HorizontalOptions="Center" />

            <!-- ============ LIEN INSCRIPTION ============ -->
            <VerticalStackLayout Spacing="0" Margin="0,10,0,0">
                <Label Text="Premi\u00e8re visite sur LocatCam ?"
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center" />
                <Button Text="Cr\u00e9er un compte"
                        Command="{Binding GoToRegisterCommand}"
                        Style="{StaticResource TextButton}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
