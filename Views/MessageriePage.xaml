<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             xmlns:models="clr-namespace:LocatCam_mobile.Models"
             x:DataType="vm:MessagerieViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.MessageriePage"
             Shell.NavBarIsVisible="False"
             Title="Messagerie"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid>

        <!-- ==================== LISTE DES CONVERSATIONS ==================== -->
        <Grid IsVisible="{Binding ConversationOuverte, Converter={StaticResource InverseBoolConverter}}"
              RowDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

            <!-- En-tête -->
            <Grid Grid.Row="0" Padding="20,14,20,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Frame Style="{StaticResource PastilleIcone}"
                       WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       VerticalOptions="Center">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRetourClicked" />
                    </Frame.GestureRecognizers>
                    <Label Text="&#xf060;" FontFamily="FASolid" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Messagerie" Style="{StaticResource H1}" />
                    <Label Text="{Binding TotalNonLus, StringFormat='{0} message(s) non lu(s)'}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Liste -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsLoadingConversations}"
                         Command="{Binding ChargerConversationsCommand}">
                <CollectionView x:Name="ListeConversations"
                                ItemsSource="{Binding Conversations}"
                                SelectionMode="Single"
                                SelectedItem="{Binding ConversationSelectionnee, Mode=TwoWay}"
                                ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="32">
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                   BorderColor="Transparent" CornerRadius="42"
                                   WidthRequest="84" HeightRequest="84" Padding="0" HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="&#xf4ad;" FontFamily="FASolid" FontSize="30"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="Aucune conversation" Style="{StaticResource H2}" HorizontalOptions="Center" />
                            <Label Text="Contactez un bailleur depuis une annonce pour démarrer une discussion."
                                   Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="280" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConversationDto">
                            <Frame Style="{StaticResource Card}" Padding="14" Margin="20,0,20,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <!-- Avatar -->
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                           BorderColor="Transparent"
                                           CornerRadius="24"
                                           WidthRequest="48" HeightRequest="48"
                                           Padding="0"
                                           HasShadow="False"
                                           VerticalOptions="Center">
                                        <Label Text="&#xf007;" FontFamily="FASolid" FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Infos -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding UtilisateurNom}"
                                               Style="{StaticResource BodyFort}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding DernierMessage, FallbackValue='Aucun message'}"
                                               Style="{StaticResource Caption}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Date + badge non lus -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding DateDernierMessage, StringFormat='{0:dd/MM HH:mm}'}"
                                               FontFamily="PlusJakartaSans"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />

                                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                               BorderColor="Transparent"
                                               CornerRadius="10"
                                               Padding="7,2"
                                               HasShadow="False"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding MessagesNonLus, Converter={StaticResource StringToBoolConverter}}">
                                            <Label Text="{Binding MessagesNonLus}"
                                                   FontFamily="PlusJakartaSansBold"
                                                   FontSize="11" FontAttributes="None"
                                                   TextColor="White" />
                                        </Frame>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Barre de navigation basse -->
            <ctrl:BottomNavBar Grid.Row="2" EstActif="MessageriePage" />

        </Grid>

        <!-- ==================== DÉTAIL D'UNE CONVERSATION ==================== -->
        <Grid IsVisible="{Binding ConversationOuverte}"
              RowDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

            <!-- En-tête conversation -->
            <Grid Grid.Row="0" Padding="20,14,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Frame Style="{StaticResource PastilleIcone}"
                       WidthRequest="40" HeightRequest="40" CornerRadius="20"
                       VerticalOptions="Center">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FermerConversationCommand}" />
                    </Frame.GestureRecognizers>
                    <Label Text="&#xf060;" FontFamily="FASolid" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding ConversationSelectionnee.UtilisateurNom}"
                           Style="{StaticResource H2}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding ConversationSelectionnee.AnnonceTitre}"
                           Style="{StaticResource Caption}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- Messages -->
            <ScrollView Grid.Row="1" x:Name="ScrollMessages">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Messages}"
                                     Spacing="10"
                                     Padding="20,8,20,12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MessageDto">
                            <VerticalStackLayout Spacing="3">
                                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                                       BorderColor="Transparent"
                                       CornerRadius="16"
                                       Padding="13,10"
                                       HasShadow="False"
                                       HorizontalOptions="Start"
                                       MaximumWidthRequest="290">
                                    <Label Text="{Binding Contenu}"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="14.5"
                                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                                           LineBreakMode="WordWrap" />
                                </Frame>
                                <Label Text="{Binding DateEnvoi, StringFormat='{0:HH:mm}'}"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="10.5"
                                       TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                       HorizontalOptions="Start"
                                       Margin="6,0,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Zone de saisie -->
            <Frame Grid.Row="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}"
                   BorderColor="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                   CornerRadius="26"
                   Padding="6,6,6,6"
                   Margin="16,8,16,16"
                   HasShadow="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding ContenuNouveauMessage}"
                           Placeholder="Écrire un message..."
                           PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                           FontFamily="PlusJakartaSans"
                           FontSize="14.5"
                           BackgroundColor="Transparent"
                           Margin="10,0,0,0"
                           VerticalOptions="Center" />

                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                           BorderColor="Transparent"
                           CornerRadius="22"
                           WidthRequest="44" HeightRequest="44"
                           Padding="0"
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EnvoyerMessageCommand}" />
                        </Frame.GestureRecognizers>
                        <Label Text="&#xf1d8;" FontFamily="FASolid" FontSize="16" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>

            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsLoadingMessages}"
                               IsVisible="{Binding IsLoadingMessages}"
                               Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,6" />
        </Grid>

    </Grid>

</ContentPage>
