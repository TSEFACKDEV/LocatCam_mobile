<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             x:DataType="vm:ProfilViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.ProfilPage"
             Shell.NavBarIsVisible="False"
             Title="Mon profil"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,14,20,20" Spacing="18">

                <!-- Bandeau hors-ligne -->
                <ctrl:OfflineBanner />

                <!-- ============ EN-TÊTE PROFIL ============ -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,4">
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                           BorderColor="Transparent"
                           CornerRadius="44"
                           WidthRequest="88" HeightRequest="88"
                           Padding="0"
                           HasShadow="False"
                           HorizontalOptions="Center">
                        <Frame.Shadow>
                            <Shadow Brush="#1565C0" Offset="0,10" Radius="22" Opacity="0.28" />
                        </Frame.Shadow>
                        <Label x:Name="AvatarInitiale"
                               Text="U"
                               FontFamily="PlusJakartaSansBold"
                               FontSize="34"
                               FontAttributes="None"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <Label Text="{Binding Nom}"
                           Style="{StaticResource H1}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding Email}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- Rôle -->
                    <Frame Style="{StaticResource Pill}"
                           Padding="12,5"
                           HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xf2c1;" FontFamily="FASolid" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Role}"
                                   FontFamily="PlusJakartaSansBold" FontSize="12" FontAttributes="None"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- ============ INFORMATIONS DU COMPTE ============ -->
                <Label Text="Informations du compte" Style="{StaticResource Micro}" Margin="4,8,0,0" />

                <Frame Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <!-- Nom -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,10">
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf007;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Nom complet" Style="{StaticResource Micro}" />
                                <Label Text="{Binding Nom}" Style="{StaticResource BodyFort}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Separateur}" Margin="54,0,0,0" />

                        <!-- Email -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,10">
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf0e0;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Email" Style="{StaticResource Micro}" />
                                <Label Text="{Binding Email}" Style="{StaticResource BodyFort}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Separateur}" Margin="54,0,0,0" />

                        <!-- Téléphone -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,10">
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf095;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Téléphone" Style="{StaticResource Micro}" />
                                <Label Text="{Binding Telephone}" Style="{StaticResource BodyFort}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ============ PRÉFÉRENCES ============ -->
                <Label Text="Préférences" Style="{StaticResource Micro}" Margin="4,8,0,0" />

                <Frame Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <!-- Mode sombre -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10">
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf186;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Mode sombre" Style="{StaticResource BodyFort}" />
                                <Label Text="Basculer le thème de l'application" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    x:Name="ThemeSwitch"
                                    Toggled="OnThemeToggled"
                                    OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{StaticResource Separateur}" Margin="54,0,0,0" />

                        <!-- Revoir l'introduction -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRevoirOnboarding" />
                            </Grid.GestureRecognizers>
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf0eb;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Revoir l'introduction" Style="{StaticResource BodyFort}" />
                                <Label Text="Redécouvrir les fonctionnalités de LocatCam" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{StaticResource Separateur}" Margin="54,0,0,0" />

                        <!-- À propos -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10">
                            <Frame Style="{StaticResource PastilleIcone}" WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                <Label Text="&#xf05a;" FontFamily="FASolid" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="À propos" Style="{StaticResource BodyFort}" />
                                <Label Text="LocatCam Mobile" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="v1.0" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ============ DÉCONNEXION ============ -->
                <Frame Style="{StaticResource Card}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorLightDark}}"
                       Padding="16"
                       Margin="0,8,0,0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeconnexionCommand}" />
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="&#xf08b;" FontFamily="FASolid" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               VerticalOptions="Center" />
                        <Label Text="Se déconnecter"
                               FontFamily="PlusJakartaSansBold" FontSize="15" FontAttributes="None"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barre de navigation basse -->
        <ctrl:BottomNavBar Grid.Row="1" EstActif="ProfilPage" />

    </Grid>

</ContentPage>
