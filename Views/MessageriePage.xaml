<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Views.MessageriePage"
             Title="Messagerie">

    <ContentPage.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- ======================== LISTE DES CONVERSATIONS ======================== -->
        <StackLayout x:Name="ListeConversationsPanel"
                     IsVisible="{Binding ConversationOuverte, Converter={StaticResource InverseBoolConverter}}"
                     Spacing="0">

            <StackLayout Margin="16, 16, 16, 8" Spacing="4">
                <Label Text="Mes conversations"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="{Binding TotalNonLus, StringFormat='{0} message(s) non lu(s)'}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
            </StackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoadingConversations}"
                               IsVisible="{Binding IsLoadingConversations}"
                               HorizontalOptions="Center" />

            <ListView ItemsSource="{Binding Conversations}"
                      SelectedItem="{Binding ConversationSelectionnee, Mode=TwoWay}"
                      RowHeight="72"
                      CachingStrategy="RecycleElement"
                      Margin="12, 0, 12, 0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="12, 8">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding UtilisateurNom}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DernierMessage, FallbackValue='Aucun message'}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding AnnonceTitre}"
                                           FontSize="12"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Italic" />
                                </StackLayout>
                                <StackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                                    <Label Text="{Binding DateDernierMessage, StringFormat='{0:dd/MM HH:mm}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Border WidthRequest="24" HeightRequest="24"
                                            BackgroundColor="{StaticResource Error}"
                                            IsVisible="{Binding MessagesNonLus, Converter={StaticResource StringToBoolConverter}}"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding MessagesNonLus}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </StackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Label Text="Aucune conversation pour le moment."
                   IsVisible="False"
                   HorizontalOptions="Center"
                   VerticalOptions="CenterAndExpand"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        </StackLayout>

        <!-- ======================== DÉTAIL CONVERSATION ======================== -->
        <StackLayout x:Name="DetailConversationPanel"
                     IsVisible="{Binding ConversationOuverte}"
                     Spacing="0">

            <Grid Margin="16, 10, 16, 8" ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="← Retour"
                        Command="{Binding FermerConversationCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        HeightRequest="40"
                        SemanticProperties.Description="Fermer la conversation"
                        SemanticProperties.Hint="Revenir à la liste des conversations" />
                <Label Grid.Column="1" Text="{Binding ConversationSelectionnee.UtilisateurNom}"
                       FontSize="18" FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                     Opacity="0.3" />

            <ScrollView>
                <StackLayout BindableLayout.ItemsSource="{Binding Messages}"
                             Spacing="10" Padding="12, 10, 12, 0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Spacing="0" HorizontalOptions="Fill">
                                <Border Padding="10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                    <Label Text="{Binding Contenu}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           LineBreakMode="WordWrap" />
                                </Border>
                                <Label Text="{Binding DateEnvoi, StringFormat='{0:HH:mm}'}"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="End"
                                       Margin="8, 0, 0, 0" />
                            </StackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
            </ScrollView>

            <Border Margin="12, 8, 12, 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    StrokeThickness="1"
                    Padding="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding ContenuNouveauMessage}"
                           Placeholder="Écrire un message..."
                           Keyboard="Text"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Button Grid.Column="1" Text="Envoyer"
                            Command="{Binding EnvoyerMessageCommand}"
                            IsEnabled="{Binding ContenuNouveauMessage, Converter={StaticResource StringToBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="40"
                            WidthRequest="80"
                            SemanticProperties.Description="Envoyer le message"
                            SemanticProperties.Hint="Envoyer le message saisi dans la conversation" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoadingMessages}"
                               IsVisible="{Binding IsLoadingMessages}"
                               HorizontalOptions="Center" />
        </StackLayout>
    </Grid>

</ContentPage>
