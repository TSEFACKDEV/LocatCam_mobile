<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ==================================================================
         TYPOGRAPHIE — Plus Jakarta Sans
         ================================================================== -->
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Label.LineHeight" Value="1.15" />
        <Setter Property="Label.CharacterSpacing" Value="-0.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Label.LineHeight" Value="1.2" />
        <Setter Property="Label.CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Label.LineHeight" Value="1.25" />
        <Setter Property="Label.CharacterSpacing" Value="-0.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Label.LineHeight" Value="1.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="BodyFort" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Label.LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Label.LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
    </Style>
    <Style x:Key="Micro" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansSemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="Label.CharacterSpacing" Value="1.1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
    </Style>
    <Style x:Key="Prix" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>

    <!-- ==================================================================
         ICÔNES (Font Awesome)
         ================================================================== -->
    <Style x:Key="IconeFa" TargetType="Label">
        <Setter Property="FontFamily" Value="FASolid" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="IconeFaPetite" TargetType="Label">
        <Setter Property="FontFamily" Value="FASolid" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
    </Style>
    <Style x:Key="IconeFaGrande" TargetType="Label">
        <Setter Property="FontFamily" Value="FASolid" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- ==================================================================
         BOUTONS
         ================================================================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Accent}" Offset="0,6" Radius="14" Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="Padding" Value="22,0" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Puce de filtre (catégories de l'accueil) -->
    <Style x:Key="FilterButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="FontFamily" Value="PlusJakartaSansSemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="17,0" />
    </Style>

    <!-- ==================================================================
         SURFACES / CARTES
         ================================================================== -->
    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Carte élevée : utilisée pour les formulaires et blocs mis en avant -->
    <Style x:Key="ElevatedCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1B2559" Offset="0,14" Radius="34" Opacity="0.08" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HasShadow" Value="False" />
    </Style>
    <Style x:Key="InputBorder" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="HasShadow" Value="False" />
    </Style>
    <Style x:Key="SearchPill" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceCardDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Pastille d'icône ronde (fond bleu très clair) -->
    <Style x:Key="PastilleIcone" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Séparateur -->
    <Style x:Key="Separateur" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
    </Style>

</ResourceDictionary>
