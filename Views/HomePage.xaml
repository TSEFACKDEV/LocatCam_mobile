<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             xmlns:models="clr-namespace:LocatCam_mobile.Models"
             x:DataType="vm:HomeViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.HomePage"
             Title="Accueil">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="ChipPilule" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Bandeau hors-ligne -->
        <ctrl:OfflineBanner Grid.Row="0" />

        <!-- Barre de recherche : pilule SurfaceSoft -->
        <Frame Grid.Row="1"
               Style="{StaticResource SearchPill}"
               Margin="16,12,16,8"
               HasShadow="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔍"
                       FontSize="18"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
                <Entry Grid.Column="1"
                       Placeholder="Rechercher un quartier, une ville..."
                       Text="{Binding Recherche}"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       BackgroundColor="Transparent" />
            </Grid>
        </Frame>

        <!-- Chips de filtre -->
        <ScrollView Grid.Row="2"
                    HorizontalScrollBarVisibility="Never"
                    VerticalOptions="Start"
                    HeightRequest="56">
            <StackLayout Orientation="Horizontal" Padding="16,0,16,0" Spacing="8">
                <Frame Style="{StaticResource ChipPilule}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       BorderColor="Transparent">
                    <Label Text="Tous" FontSize="14" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </Frame>
                <Frame Style="{StaticResource ChipPilule}">
                    <Label Text="Appartement" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                           VerticalOptions="Center" />
                </Frame>
                <Frame Style="{StaticResource ChipPilule}">
                    <Label Text="Maison" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                           VerticalOptions="Center" />
                </Frame>
                <Frame Style="{StaticResource ChipPilule}">
                    <Label Text="Studio" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                           VerticalOptions="Center" />
                </Frame>
                <Frame Style="{StaticResource ChipPilule}">
                    <Label Text="Meublé" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"
                           VerticalOptions="Center" />
                </Frame>
            </StackLayout>
        </ScrollView>

        <!-- Liste des annonces -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RafraichirCommand}">
            <CollectionView ItemsSource="{Binding Annonces}"
                            ItemSizingStrategy="MeasureFirstItem"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding ChargerPlusCommand}">
                <CollectionView.EmptyView>
                    <ctrl:EmptyStateView
                        Icone="🏠"
                        Titre="Aucune annonce"
                        Message="Aucune annonce trouvée pour votre recherche."
                        BoutonTexte="Réessayer"
                        BoutonCommande="{Binding RafraichirCommand}"
                        AfficherBouton="True" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AnnonceDto">
                        <ctrl:AnnonceCard
                            Titre="{Binding Titre}"
                            Prix="{Binding Prix}"
                            Ville="{Binding Ville}"
                            Quartier="{Binding Quartier}"
                            Type="{Binding Type}"
                            Statut="{Binding Statut}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Skeleton loading -->
        <StackLayout Grid.Row="3"
                     IsVisible="{Binding IsLoading}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Spacing="12">
            <ctrl:SkeletonCard WidthRequest="340" HeightRequest="270" />
            <ctrl:SkeletonCard WidthRequest="340" HeightRequest="270" />
            <ctrl:SkeletonCard WidthRequest="340" HeightRequest="270" />
        </StackLayout>

        <!-- Bottom navigation custom (animée) -->
        <ctrl:BottomNavBar Grid.Row="4" EstActif="HomePage" />

    </Grid>

</ContentPage>
