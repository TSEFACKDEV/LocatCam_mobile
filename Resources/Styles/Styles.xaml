<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="InkPrimary">#222222</Color>
    <Color x:Key="InkPrimaryDark">#E8E8E8</Color>
    <Color x:Key="InkSecondary">#6A6A6A</Color>
    <Color x:Key="InkSecondaryDark">#B0B0B0</Color>
    <Color x:Key="InkMuted">#929292</Color>
    <Color x:Key="InkMutedDark">#7A7A7A</Color>
    <Color x:Key="Accent">#1565C0</Color>
    <Color x:Key="AccentDark">#5B9BD5</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceCardDark">#1E1E1E</Color>
    <Color x:Key="SurfaceSoft">#F7F7F7</Color>
    <Color x:Key="SurfaceSoftDark">#1E1E1E</Color>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Label.LineHeight" Value="1.2" />
        <Setter Property="Label.CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Label.LineHeight" Value="1.25" />
        <Setter Property="Label.CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Label.LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Label.LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Label.LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
    </Style>
    <Style x:Key="Micro" TargetType="Label">
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="Label.CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontFamily" Value="PlusJakartaSans" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="Pill" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="InputBorder" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="SearchPill" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSoft}, Dark={StaticResource SurfaceSoftDark}}" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HasShadow" Value="False" />
    </Style>
</ResourceDictionary>
