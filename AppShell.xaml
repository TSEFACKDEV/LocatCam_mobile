<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LocatCam_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LocatCam_mobile.Views"
    Title="LocatCam">

    <!-- Onglet 1 : Accueil -->
    <ShellContent
        Title="Accueil"
        Icon="home.png"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <!-- Onglet 2 : Carte -->
    <ShellContent
        Title="Carte"
        Icon="map.png"
        ContentTemplate="{DataTemplate views:CartePage}"
        Route="CartePage" />

    <!-- Onglet 3 : Favoris -->
    <ShellContent
        Title="Favoris"
        Icon="favorite.png"
        ContentTemplate="{DataTemplate views:FavorisPage}"
        Route="FavorisPage" />

    <!-- Onglet 4 : Messagerie -->
    <ShellContent
        Title="Messages"
        Icon="message.png"
        ContentTemplate="{DataTemplate views:MessageriePage}"
        Route="MessageriePage" />

    <!-- Onglet 5 : Profil -->
    <ShellContent
        Title="Profil"
        Icon="person.png"
        ContentTemplate="{DataTemplate views:ProfilPage}"
        Route="ProfilPage" />

    <!-- Pages de connexion (pas d'onglet, accessibles via navigation) -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Page d'inscription -->
    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />

    <!-- Détail annonce (accédé via navigation paramétrée) -->
    <ShellContent
        Title="Détail annonce"
        ContentTemplate="{DataTemplate views:DetailAnnoncePage}"
        Route="DetailAnnoncePage" />

</Shell>
