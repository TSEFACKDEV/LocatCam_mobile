<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Couleurs principales LocatCam -->
    <Color x:Key="Primary">#1565C0</Color>
    <Color x:Key="PrimaryLight">#64B5F6</Color>
    <Color x:Key="PrimaryDark">#0D47A1</Color>
    
    <Color x:Key="Secondary">#2E7D32</Color>
    <Color x:Key="SecondaryLight">#81C784</Color>
    
    <Color x:Key="Surface">#FAFAFA</Color>
    <Color x:Key="SurfaceDark">#212121</Color>
    
    <Color x:Key="Error">#D32F2F</Color>
    <Color x:Key="ErrorLight">#FFCDD2</Color>
    
    <Color x:Key="Success">#388E3C</Color>
    <Color x:Key="SuccessLight">#C8E6C9</Color>
    
    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextPrimaryDark">#FAFAFA</Color>
    <Color x:Key="TextSecondary">#757575</Color>
    <Color x:Key="TextSecondaryDark">#BDBDBD</Color>
    
    <Color x:Key="Background">#FFFFFF</Color>
    <Color x:Key="BackgroundDark">#121212</Color>

</ResourceDictionary>
