<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocatCam_mobile.Controls.SkeletonCard"
             HeightRequest="300">

    <Frame Style="{StaticResource Card}">
        <Frame.Shadow>
            <Shadow Brush="#000000" Offset="0,6" Radius="14" Opacity="0.08" />
        </Frame.Shadow>

        <Grid RowDefinitions="180,Auto,Auto,Auto">

            <!-- Skeleton photo -->
            <BoxView Grid.Row="0"
                     Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     CornerRadius="18,18,0,0" />

            <!-- Skeleton titre -->
            <BoxView Grid.Row="1"
                     Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     HeightRequest="16"
                     WidthRequest="200"
                     Margin="14,14,14,6"
                     CornerRadius="8"
                     HorizontalOptions="Start" />

            <!-- Skeleton sous-titre -->
            <BoxView Grid.Row="2"
                     Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     HeightRequest="12"
                     WidthRequest="140"
                     Margin="14,0,14,0"
                     CornerRadius="6"
                     HorizontalOptions="Start" />

            <!-- Skeleton prix -->
            <BoxView Grid.Row="3"
                     Color="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}"
                     HeightRequest="16"
                     WidthRequest="96"
                     Margin="14,12,14,16"
                     CornerRadius="8"
                     HorizontalOptions="Start" />

        </Grid>
    </Frame>

</ContentView>
