<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             xmlns:models="clr-namespace:LocatCam_mobile.Models"
             x:DataType="vm:HomeViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.HomePage"
             Shell.NavBarIsVisible="False"
             Title="Accueil">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

        <!-- Bandeau hors-ligne -->
        <ctrl:OfflineBanner Grid.Row="0" />

        <!-- ============ EN-TÊTE : LOGO + BONJOUR ============ -->
        <Grid Grid.Row="1" Margin="20,14,20,6" ColumnDefinitions="Auto,*,Auto">
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                   BorderColor="Transparent"
                   CornerRadius="12"
                   Padding="0"
                   WidthRequest="40"
                   HeightRequest="40"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Label Text="&#xf015;" FontFamily="FASolid" FontSize="18" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="0" VerticalOptions="Center">
                <Label Text="LocatCam" Style="{StaticResource H1}" />
                <Label Text="Trouvez votre logement au Cameroun"
                       Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- Accès direct à la messagerie -->
            <Frame Grid.Column="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                   BorderColor="Transparent"
                   CornerRadius="20"
                   Padding="0"
                   WidthRequest="40"
                   HeightRequest="40"
                   HasShadow="False"
                   VerticalOptions="Center"
                   SemanticProperties.Description="Ouvrir la messagerie">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMessagesClicked" />
                </Frame.GestureRecognizers>
                <Label Text="&#xf4ad;" FontFamily="FASolid" FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
        </Grid>

        <!-- ============ BARRE DE RECHERCHE ============ -->
        <Frame Grid.Row="2"
               Style="{StaticResource SearchPill}"
               Margin="20,10,20,4">
            <Frame.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.08" />
            </Frame.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="&#xf002;" FontFamily="FASolid" FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       VerticalOptions="Center"
                       Margin="10,0,0,0" />

                <Entry Grid.Column="1"
                       Placeholder="Ville, quartier, type de logement..."
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       Text="{Binding Recherche}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       FontFamily="PlusJakartaSans"
                       FontSize="14.5"
                       ReturnType="Search"
                       ReturnCommand="{Binding RechercherCommand}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />

                <!-- Bouton rechercher (rond, bleu) -->
                <Frame Grid.Column="2"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                       BorderColor="Transparent"
                       CornerRadius="20"
                       Padding="0"
                       WidthRequest="40"
                       HeightRequest="40"
                       HasShadow="False"
                       VerticalOptions="Center">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RechercherCommand}" />
                    </Frame.GestureRecognizers>
                    <Label Text="&#xf002;" FontFamily="FASolid" FontSize="15" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
            </Grid>
        </Frame>

        <!-- ============ FILTRE PRIX (budget) ============ -->
        <Frame Grid.Row="3"
               Style="{StaticResource SearchPill}"
               Margin="20,6,20,6">
            <Frame.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.08" />
            </Frame.Shadow>
            <Grid ColumnDefinitions="Auto,10,Auto,10,Auto,10,Auto,*" ColumnSpacing="6">
                <Label Grid.Column="0" Text="&#xf155;" FontFamily="FASolid" FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2" Text="min" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Entry Grid.Column="4"
                       Keyboard="Numeric"
                       Text="{Binding PrixMinTexte}"
                       Placeholder="Prix min"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       FontFamily="PlusJakartaSans"
                       FontSize="13"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
                <Label Grid.Column="6" Text="max" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Entry Grid.Column="8"
                       Keyboard="Numeric"
                       Text="{Binding PrixMaxTexte}"
                       Placeholder="Prix max"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"
                       FontFamily="PlusJakartaSans"
                       FontSize="13"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!-- ============ CHIPS DE FILTRE ============ -->
        <ScrollView Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalOptions="Start"
                    HeightRequest="56">
            <HorizontalStackLayout Padding="20,7,20,7" Spacing="8">

                <Button Text="Tous"
                        Style="{StaticResource FilterButton}"
                        Command="{Binding FiltrerCommand}"
                        CommandParameter="Tous">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Tous">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Appartement"
                        Style="{StaticResource FilterButton}"
                        Command="{Binding FiltrerCommand}"
                        CommandParameter="Appartement">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Appartement">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Maison"
                        Style="{StaticResource FilterButton}"
                        Command="{Binding FiltrerCommand}"
                        CommandParameter="Maison">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Maison">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Studio"
                        Style="{StaticResource FilterButton}"
                        Command="{Binding FiltrerCommand}"
                        CommandParameter="Studio">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Studio">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Meublé"
                        Style="{StaticResource FilterButton}"
                        Command="{Binding FiltrerCommand}"
                        CommandParameter="Meublé">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Meublé">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ============ LISTE DES ANNONCES ============ -->
        <RefreshView Grid.Row="5"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RafraichirCommand}"
                     RefreshColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}">
            <CollectionView x:Name="ListeAnnonces"
                            ItemsSource="{Binding Annonces}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding ChargerPlusCommand}">
                <CollectionView.Header>
                    <Grid Padding="20,8,20,10" ColumnDefinitions="*,Auto">
                        <Label Text="Annonces disponibles" Style="{StaticResource H2}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding TotalCount, StringFormat='{0} résultats'}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="18" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <ctrl:EmptyStateView
                        Icone="&#xf015;"
                        Titre="Aucune annonce"
                        Message="Aucune annonce ne correspond à votre recherche. Essayez une autre ville ou un autre quartier."
                        BoutonTexte="Réessayer"
                        BoutonCommande="{Binding RafraichirCommand}"
                        AfficherBouton="True" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AnnonceDto">
                        <Grid Padding="20,0,20,0">
                            <ctrl:AnnonceCard Tapped="OnAnnonceTapped"
                                Titre="{Binding Titre}"
                                Prix="{Binding Prix}"
                                Ville="{Binding Ville}"
                                Quartier="{Binding Quartier}"
                                Type="{Binding Type}"
                                Statut="{Binding Statut}"
                                EstVerifie="{Binding EstVerifie}"
                                PhotoUrl="{Binding PhotoPrincipaleUrl}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Skeleton loading (premier chargement) -->
        <VerticalStackLayout Grid.Row="5"
                             IsVisible="{Binding IsLoading}"
                             Padding="20,10,20,0"
                             Spacing="18">
            <ctrl:SkeletonCard />
            <ctrl:SkeletonCard />
            <ctrl:SkeletonCard />
        </VerticalStackLayout>

        <!-- Barre de navigation basse -->
        <ctrl:BottomNavBar Grid.Row="6" EstActif="HomePage" />

    </Grid>

</ContentPage>
