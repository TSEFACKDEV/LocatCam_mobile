<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:LocatCam_mobile.Converters"
             xmlns:ctrl="clr-namespace:LocatCam_mobile.Controls"
             xmlns:models="clr-namespace:LocatCam_mobile.Models"
             x:DataType="vm:FavorisViewModel"
             xmlns:vm="clr-namespace:LocatCam_mobile.ViewModels"
             x:Class="LocatCam_mobile.Views.FavorisPage"
             Shell.NavBarIsVisible="False"
             Title="Mes favoris"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

        <!-- Bandeau hors-ligne -->
        <ctrl:OfflineBanner Grid.Row="0" />

        <!-- ============ EN-TÊTE ============ -->
        <VerticalStackLayout Grid.Row="1" Padding="20,14,20,8" Spacing="2">
            <Label Text="Mes favoris" Style="{StaticResource H1}" />
            <Label Text="Vos logements sauvegardés, disponibles hors-ligne"
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <!-- ============ LISTE ============ -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding ChargerFavorisCommand}"
                     RefreshColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}">
            <CollectionView x:Name="ListeFavoris"
                            ItemsSource="{Binding Favoris}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="18" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <ctrl:EmptyStateView
                        Icone="&#xf004;"
                        Titre="Aucun favori"
                        Message="Appuyez sur le cœur d'une annonce pour la retrouver ici, même sans connexion."
                        AfficherBouton="False" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AnnonceDto">
                        <Grid Padding="20,0,20,0">
                            <ctrl:AnnonceCard Tapped="OnFavoriTapped"
                                Titre="{Binding Titre}"
                                Prix="{Binding Prix}"
                                Ville="{Binding Ville}"
                                Quartier="{Binding Quartier}"
                                Type="{Binding Type}"
                                Statut="{Binding Statut}"
                                EstVerifie="{Binding EstVerifie}"
                                PhotoUrl="{Binding PhotoPrincipaleUrl}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Skeleton loading -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding IsLoading}"
                             Padding="20,10,20,0"
                             Spacing="18">
            <ctrl:SkeletonCard />
            <ctrl:SkeletonCard />
        </VerticalStackLayout>

        <!-- Barre de navigation basse -->
        <ctrl:BottomNavBar Grid.Row="3" EstActif="FavorisPage" />

    </Grid>

</ContentPage>
